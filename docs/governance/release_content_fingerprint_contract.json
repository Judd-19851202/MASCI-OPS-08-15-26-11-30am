{
  "deployable_source_inputs": {
    "schema_version": "MASCI_DEPLOYABLE_SOURCE_INPUT_CONTRACT/v1",
    "algorithm_version": "dcf-1",
    "purpose": "Canonical DEPLOYABLE_CONTENT_FINGERPRINT scope: only repository-controlled source inputs that can materially alter deployed MASCI behavior. This is a distinct identity universe from the broad workspace diagnostic manifest below and MUST NEVER be compared against it.",
    "include_roots": [
      "backend/lib",
      "backend/routes",
      "backend/services",
      "backend/scripts",
      "backend/server.py",
      "backend/requirements.txt",
      "frontend/src",
      "frontend/public",
      "frontend/scripts",
      "frontend/package.json",
      "frontend/yarn.lock",
      "frontend/craco.config.js",
      "frontend/postcss.config.js",
      "frontend/tailwind.config.js",
      "frontend/jsconfig.json",
      "frontend/eslint.config.js",
      "frontend/components.json",
      "scripts"
    ],
    "exclude_exact": [
      "AUTHORIZED_RELEASE.json"
    ],
    "exclude_globs": [
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.log",
      "backend/tests/**",
      "frontend/src/**/__tests__/**",
      "frontend/src/**/*.test.js",
      "frontend/src/**/*.test.jsx",
      "frontend/src/buildVersion.generated.js",
      "frontend/public/release-identity.json",
      "frontend/public/release-provenance.json",
      "**/.DS_Store"
    ],
    "normalize": {
      "line_endings": "lf"
    }
  },
  "schema_version": "MASCI_RELEASE_CONTENT_FINGERPRINT_CONTRACT/v1",
  "algorithm_version": "masci-release-content-sha256-v1",
  "include_roots": [
    "backend",
    "frontend",
    "scripts",
    "docs",
    "memory",
    ".github",
    ".emergent",
    ".deploy_checks",
    "auth_testing.md",
    "release_identity_scope.json",
    ".env.example",
    ".gitignore",
    ".dockerignore",
    "pytest.ini"
  ],
  "exclude_exact": [
    "memory/PRE_SAVE_CONTENT_FINGERPRINT.json",
    "backend/static/runtime-data/DEPLOYMENT_HISTORY.json",
    ".emergent/cron/applied.hash"
  ],
  "exclude_globs": [
    ".git/**",
    ".screenshots/**",
    "**/__pycache__/**",
    "**/*.pyc",
    ".pytest_cache/**",
    ".ruff_cache/**",
    ".mypy_cache/**",
    "frontend/node_modules/**",
    "frontend/build/**",
    "frontend/.cache/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "test_reports/**",
    "memory/runtime_incidents/**",
    "**/*.log",
    ".DS_Store",
    "backend/.env",
    "frontend/.env",
    "frontend/.env.*",
    "backend/.env.*"
  ],
  "normalize": {
    ".emergent/emergent.yml": {
      "format": "json",
      "drop_keys": [
        "created_at"
      ]
    }
  }
}