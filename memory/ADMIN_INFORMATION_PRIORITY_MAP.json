{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "iteration": "iter437-phase-iv-a",
  "status": "LOCKED",
  "doctrine": "Every admin route is classified by operational priority. This map drives sidebar grouping, dashboard weighting, notification routing weight, AI-coaching emphasis, and future per-role personalization. The map is the source of truth — visual treatment must derive from it.",
  "extends": [
    "ADMIN_DOMAIN_MAP.json",
    "SIDEBAR_REARCHITECTURE.md"
  ],
  "definitions": {
    "operational_tier": {
      "tier_0": "Operationally critical · platform-defining · loss of access is an emergency",
      "tier_1": "Daily operational core · used multiple times per shift by primary operators",
      "tier_2": "Daily supervisory · used at least once per shift by PMs/admins",
      "tier_3": "Periodic operational · weekly cadence (audits, comms config, training)",
      "tier_4": "Infrastructure / governance · monthly or on-incident cadence",
      "tier_5": "Rare / forensic · accessed during incidents, audits, or migrations only"
    },
    "frequency_class": {
      "always_on": "Visible at all times via persistent UI (badge, banner, sidebar count)",
      "shift_critical": "Opened ≥ once per shift by the assigned role",
      "daily": "Opened ≥ once per day",
      "weekly": "Opened ≥ once per week",
      "monthly": "Opened ≥ once per month",
      "on_incident": "Opened only during specific operational events"
    },
    "urgency_class": {
      "real_time": "Latency matters in seconds — operator decisions block on response",
      "near_real_time": "Latency matters in tens of seconds — operator workflow is degraded by lag",
      "interactive": "Latency matters in 1–3 seconds — standard operational responsiveness",
      "deferred": "Latency acceptable up to 10 seconds — batch/report-style work",
      "background": "Latency tolerable to minutes — admin/maintenance work"
    },
    "mobile_priority": {
      "primary": "Must be first-class on mobile · primary CTA in thumb zone · drawer entry visible without scroll",
      "secondary": "Functional on mobile but not optimized for thumb-only use",
      "desktop_first": "Designed for desktop · mobile is read-only or limited",
      "desktop_only": "Not exposed on mobile · attempting access redirects to a 'desktop required' surface"
    },
    "sidebar_placement_class": {
      "domain_root": "Appears as a Tier-1 domain row in the sidebar (one of 6 + 1 governance)",
      "domain_child": "Appears as a Tier-2 sub-entry when its parent domain is expanded",
      "footer_rail": "Appears in the sidebar footer rail (Tasks, PO Requests, Guidance — cross-portal pinned)",
      "topbar_widget": "Appears as a top-bar icon button (notifications, account, current-context)",
      "hidden_from_sidebar": "Not in the sidebar at all — accessed via direct URL, deep-link, or in-context redirect"
    },
    "visibility_rules": {
      "always_visible": "Shown to every authenticated admin",
      "permission_gated": "Shown only if the role has the required permission",
      "feature_flag_gated": "Shown only if the relevant feature flag is enabled",
      "incident_gated": "Shown only when an active incident matches the route's domain"
    },
    "future_collapse_behavior": {
      "default_expanded": "Domain is expanded for fresh logins of any role",
      "default_collapsed": "Domain is collapsed for fresh logins; operator opens manually",
      "role_default": "Expanded if role default is 'expanded' per role config; otherwise collapsed",
      "last_visited": "Auto-expands if the operator last visited any sub-entry of this domain"
    }
  },
