  "future_collapse_logic": {
    "doctrine": "The sidebar persists per-account state across sessions. Defaults below apply only to first login or post-reset.",
    "persistence_keys": {
      "open_domains": "masci.admin.sidebar.openDomains",
      "last_domain": "masci.admin.sidebar.lastDomain",
      "mobile_expanded": "masci.admin.sidebar.mobileExpanded"
    },
    "first_login_default_open": ["operations"],
    "post_reset_behavior": "Roles' default_for_roles + role_visibility_recommendations.expanded_by_default are merged and applied."
  },
  "dashboard_weighting": {
    "doctrine": "Future admin landing-page dashboards use operational_tier as the primary weighting signal. Tier-1 routes surface as headline cards; tier-2 as standard cards; tier-3 as collapsed sections; tier-4+ are not surfaced on the dashboard.",
    "card_weight_per_tier": {
      "tier_0": "hero (full-width)",
      "tier_1": "headline (50% width)",
      "tier_2": "standard (33% width)",
      "tier_3": "compact (25% width or grouped)",
      "tier_4": "not-on-dashboard",
      "tier_5": "not-on-dashboard"
    }
  },
  "notification_weighting": {
    "doctrine": "When multiple notifications compete for the bell badge, operational_tier ranks them. Equal tiers fall back to severity tier (see COMMUNICATION_TONE_STANDARD §II), then to recency.",
    "sort_order": ["operational_tier_asc", "severity_tier_desc", "created_at_desc"]
  },
  "ai_routing_hints": {
    "doctrine": "Future AI-assisted coaching uses this map to decide which surface to suggest. The assistant never recommends a tier-5 route unless the operator explicitly asks for it.",
    "suggestion_priority": ["tier_1", "tier_2", "tier_3"],
    "never_auto_suggest": ["tier_4", "tier_5"]
  },
  "governance": {
    "owner": "Platform Engineering · Operational Governance Lead",
    "amendment_process": "Any tier reclassification or new route addition requires (a) PR with this JSON updated, (b) PR with sidebar component reflecting the change, (c) regression test covering the new route, (d) operational signoff from a senior PM.",
    "no_silent_drift": "The deploy gate verifies that every admin route in the React Router config has an entry in this JSON. New routes without entries fail deploy."
  }
}
