{
  "version": "1.0.0",
  "iteration": "iter437-phase-iv",
  "doctrine": "Every admin function belongs to exactly one governed domain. No duplicates. No drift.",
  "domains": [
    {
      "id": "identity-access",
      "ordinal": 1,
      "label": "Identity & Access",
      "icon": "ShieldCheck",
      "description": "Portal users, roles, permissions, MFA, magic links, sessions",
      "permissions": ["super_admin", "admin"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 1000,
      "current_routes": [
        "/admin/people",
        "/admin/mfa",
        "/admin/sessions",
        "/admin/audit-log#auth"
      ],
      "target_canonical_route": "/admin/identity"
    },
    {
      "id": "operations",
      "ordinal": 2,
      "label": "Operations",
      "icon": "Activity",
      "description": "Daily reports, meetings, production, field oversight",
      "permissions": ["admin", "pm_scoped"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 2000,
      "current_routes": [
        "/admin/inspections",
        "/admin/meetings",
        "/admin/operations-events",
        "/admin/operational-inventory",
        "/project-health"
      ],
      "target_canonical_route": "/admin/operations"
    },
    {
      "id": "fleet-equipment",
      "ordinal": 3,
      "label": "Fleet & Equipment",
      "icon": "Wrench",
      "description": "Equipment, fleet health, pre-op, maintenance, GPS",
      "permissions": ["admin", "shop", "dispatch"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 1500,
      "current_routes": [
        "/admin/equipment",
        "/admin/assets/:id",
        "/admin/leadership-equipment",
        "/admin/equipment/:id/history",
        "/admin/jha-plans",
        "/admin/trench-boxes"
      ],
      "target_canonical_route": "/admin/fleet"
    },
    {
      "id": "dispatch-logistics",
      "ordinal": 4,
      "label": "Dispatch & Logistics",
      "icon": "Truck",
      "description": "Dispatch board, truck routing, drivers, transfers",
      "permissions": ["admin", "dispatch"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 2000,
      "current_routes": [
        "/admin/dispatch",
        "/admin/dls/shift-qr",
        "/admin/dls/day-1-debrief",
        "/admin/dls/week-1-debrief",
        "/asset-transfers"
      ],
      "target_canonical_route": "/admin/dispatch"
    },
    {
      "id": "hr-workforce",
      "ordinal": 5,
      "label": "HR & Workforce",
      "icon": "Users",
      "description": "Time-off, onboarding, payroll, certs, terminations",
      "permissions": ["admin", "hr"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 3000,
      "regression_locked": ["/api/hr/time-verification < 3s"],
      "current_routes": [
        "/admin/people#hr",
        "/admin/training",
        "/admin/terminations",
        "/document-expirations",
        "/admin/employees/:id/history"
      ],
      "target_canonical_route": "/admin/hr"
    },
    {
      "id": "safety-compliance",
      "ordinal": 6,
      "label": "Safety & Compliance",
      "icon": "ClipboardCheck",
      "description": "Incidents, audits, OSHA, certifications, findings",
      "permissions": ["admin", "safety"],
      "mobile_safe": true,
      "ipad_safe": true,
      "sla_ms_p95": 1500,
      "current_routes": [
        "/admin/qaqc",
        "/admin/compliance",
        "/admin/compliance-findings",
        "/admin/jha-plans#safety"
      ],
      "target_canonical_route": "/admin/safety"
    },
    {
      "id": "communications",
      "ordinal": 7,
      "label": "Communications",
      "icon": "Mail",
      "description": "Email, notifications, templates, automation, escalation",
      "permissions": ["admin"],
      "mobile_safe": false,
      "ipad_safe": true,
      "sla_ms_p95": 1000,
      "gold_standard": "po_digest.py PM weekly digest shell",
      "current_routes": [
        "/admin/email",
        "/admin/digest-config"
      ],
      "target_canonical_route": "/admin/communications"
    },
    {
      "id": "data-storage",
      "ordinal": 8,
      "label": "Data & Storage",
      "icon": "Database",
      "description": "Backups, restore, Atlas health, R2, retention, contamination probes",
      "permissions": ["super_admin", "admin"],
      "mobile_safe": false,
      "ipad_safe": true,
      "sla_ms_p95": 2000,
      "current_routes": [
        "/admin/database",
        "/admin/system#backups",
        "/admin/deploy-recovery",
        "/admin/legacy-imports"
      ],
      "target_canonical_route": "/admin/data"
    },
    {
      "id": "system-health",
      "ordinal": 9,
      "label": "System Health",
      "icon": "Activity",
      "description": "Observability, regression, gates, deploy status, cluster",
      "permissions": ["super_admin", "admin"],
      "mobile_safe": false,
      "ipad_safe": true,
      "sla_ms_p95": 1000,
      "current_routes": [
        "/admin/system-health",
        "/admin/deploy-readiness",
        "/admin/operations-events#system"
      ],
      "target_canonical_route": "/admin/health"
    },
    {
      "id": "governance",
      "ordinal": 10,
      "label": "Governance",
      "icon": "ShieldCheck",
      "description": "Lifecycle rules, audit doctrine, cleanup doctrine, deploy governance",
      "permissions": ["super_admin"],
      "mobile_safe": false,
      "ipad_safe": true,
      "sla_ms_p95": 5000,
      "current_routes": [
        "/admin/governance",
        "/admin/operational-language",
        "/admin/guidance-coverage",
        "/admin/audit-log#governance"
      ],
      "target_canonical_route": "/admin/governance"
    }
  ],
  "moved_out_of_admin": [
    "/tasks",
    "/document-expirations",
    "/po-requests",
    "/project-health",
    "/asset-transfers",
    "/guidance",
    "/admin/promo-assets"
  ],
  "guardrails": {
    "no_url_deletion": true,
    "no_backend_route_changes_in_this_phase": true,
    "max_loc_per_pr": 500,
    "regression_suite_required_between_domains": true,
    "mobile_ipad_smoke_required_per_domain": true,
    "single_nav_surface": "AdminShell.jsx"
  }
}
