  "role_visibility_recommendations": {
    "pm": {
      "expanded_by_default": ["project-operations"],
      "collapsed_by_default": ["financials-cost", "field-coordination", "document-control", "compliance-risk", "system-communications"],
      "hidden_routes": []
    },
    "admin": {
      "comment": "Admins viewing /pm/* surfaces inherit the PM scope but see all PMs' data. Same V2 sidebar layout, no hidden routes.",
      "expanded_by_default": ["project-operations", "compliance-risk"],
      "collapsed_by_default": ["financials-cost", "field-coordination", "document-control", "system-communications"]
    }
  },
  "dashboard_weighting": {
    "doctrine": "PM Hub overview surfaces are weighted by operational_tier. Tier-1 routes get hero treatment; tier-3+ are not surfaced on the Hub.",
    "card_weight_per_tier": {
      "tier_1": "hero or headline",
      "tier_2": "standard card",
      "tier_3": "compact or grouped",
      "tier_4": "not-on-hub",
      "tier_5": "not-on-hub"
    }
  },
  "notification_weighting": {
    "sort_order": ["operational_tier_asc", "severity_tier_desc", "created_at_desc"]
  },
  "governance": {
    "owner": "Platform Engineering · Operational Governance Lead",
    "amendment_process": "Any tier reclassification or new PM route addition requires (a) PR with this JSON updated, (b) PR with sidebar component reflecting the change, (c) regression test, (d) operational signoff from a senior PM.",
    "no_silent_drift": "The deploy gate verifies that every PM route in App.js has an entry in this JSON OR is explicitly listed in moved_out_of_pm. New routes without entries fail deploy."
  },
  "moved_out_of_pm_sidebar": [
    {
      "path": "/pm/crew-compliance",
      "comment": "Lives in Compliance & Risk in sidebar AND remains as a Hub overview card (preserved per audit §9)."
