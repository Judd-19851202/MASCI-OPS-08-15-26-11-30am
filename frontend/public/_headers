# Cloudflare Pages / Netlify-style header rules for static assets.
#
# Read in order; first match wins. Rules apply to the *path served by
# the origin* — Cloudflare honours these as long as the upstream server
# emits them (CRA's `serve` and most static hosts pass them through).
#
# If your host does NOT honour `_headers`, paste these rules into
# Cloudflare → Rules → Page Rules / Cache Rules manually for
# https://mascidocs.com/...
#
# Why short cache on logos:
#   /masci-mark*.png and /masci-full-lockup*.png are the brand assets
#   we swap occasionally. A 5-minute cache ceiling means a logo refresh
#   propagates to every browser within 5 min of a deploy without us
#   having to bump the filename or cache-bust by query string.
#
# Why long cache on hashed JS / CSS bundles:
#   CRA already content-hashes them, so they're safe to cache for a
#   year — a new build means a new filename anyway.

/masci-mark.png
  Cache-Control: public, max-age=300, must-revalidate

/masci-mark-onlight.png
  Cache-Control: public, max-age=300, must-revalidate

/masci-full-lockup.png
  Cache-Control: public, max-age=300, must-revalidate

/masci-full-lockup-onlight.png
  Cache-Control: public, max-age=300, must-revalidate

/masci-wordmark.png
  Cache-Control: public, max-age=300, must-revalidate

/masci-wordmark-onlight.png
  Cache-Control: public, max-age=300, must-revalidate

/og-image.png
  Cache-Control: public, max-age=300, must-revalidate

# Browser / mobile icons can be cached longer — they live in the
# manifest and any swap will also bump the filename in `index.html`.
/favicon*.png
  Cache-Control: public, max-age=604800

/apple-touch-icon*.png
  Cache-Control: public, max-age=604800

/icon-*.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# Hashed CRA build output — safe to cache forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Application bootstrap MUST revalidate on every load so a deployed release
# cannot leave an obsolete app shell living in the browser cache. The HTML is
# tiny and references content-hashed /static/* assets, so revalidation is cheap
# and correct. This is the Zero-Stale-Client app-shell revalidation contract.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# The CRA asset manifest maps logical chunks to their current hashed files;
# it must never be served stale or the shell could request obsolete chunks.
/asset-manifest.json
  Cache-Control: no-cache, must-revalidate

# The (narrow, thumbnail-only) service worker script must revalidate so an
# updated worker is picked up promptly and an old one is never pinned.
/sw-thumbs.js
  Cache-Control: no-cache, must-revalidate
